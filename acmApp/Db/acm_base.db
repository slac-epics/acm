record(aai, "$(P)Tb:AI") {
    field(DTYP, "ACM TB Hist")
    field(INP , "@$(DEV) offset=0")
    field(SCAN, "10 second")
    field(FTVL, "DOUBLE")
    field(NELM, "1024")
    field(FLNK, "$(P)Tb:BI")
}

record(aai, "$(P)Tb:BI") {
    field(FTVL, "DOUBLE")
    field(DTYP, "ACM TB Hist")
    field(INP , "@$(DEV) offset=1")
    field(NELM, "1024")
    field(FLNK, "")
}
