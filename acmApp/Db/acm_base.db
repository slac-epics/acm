

record(mbboDirect, "$(P)LogSp") {
    field(DTYP, "ACM Log Mask")
    field(OUT , "@$(DEV)")
    field(PINI, "YES")
    field(PHAS, "-1")
    field(NOBT, "16")
    field(RVAL, "$(DEBUG=1)") # enable only error messages by default
    info(autosaveFields_pass0, "RVAL")
}

record(stringin, "$(P)IpI") {
    field(DTYP, "ACM Info")
    field(INP , "@$(DEV) offset=1")
    field(PINI, "YES")
}

record(stringin, "$(P)SwverI") {
    field(DTYP, "ACM Info")
    field(INP , "@$(DEV) offset=2")
    field(PINI, "YES")
}

record(bi, "$(P)ConnSts") {
    field(DTYP, "ACM Status")
    field(INP , "@$(DEV) offset=0")
    field(SCAN, "1 second")
    field(ZNAM, "Timeout")
    field(ONAM, "Running")
    field(ZSV , "MAJOR")
}

# Stat counters
#
# Every counter below is kept separately for each of the five ACM packet types
# defined by ACMType::type in acmApp/src/acm_drv.h, plus a sixth "Unknown"
# bucket, so that a problem with one stream can be told apart from a problem
# with another.  The PV name carries the type name and the cmd= link parameter
# carries the corresponding ID field value:
#
#   HealthData  cmd=0xae  device and board health registers
#   RegData     cmd=0x51  measurement and configuration registers
#   SampFault   cmd=0xe7  waveform samples captured by a fault trip
#   SampInt     cmd=0x33  waveform samples captured by an internal trigger
#   SampExt     cmd=0x28  waveform samples captured by an external trigger
#   Unknown     cmd=0x00  events not attributable to any of the above
#
# Each counter is a free running total that is never reset while the IOC is up,
# and each has a companion :Rate: record that reports its first difference over
# a 1 second scan.  The counters are read without locking, so a :Cnt: and a
# :Rate: sampled in the same scan may straddle an update by one count.

# Receive timeouts for the stream as a whole, counted once per transition into
# the timed out state, not once per second spent there.  The receive socket has
# a acmRxTimeoutMS timeout; when nothing at all arrives from any peer for that
# long, the driver declares the stream down, discards every retained and
# partial sequence so stale values stop being published, and re-sends a
# registration packet to each configured peer to ask it to resume streaming.
#
# This is the only counter here that is not split by packet type.  A global
# timeout is by definition the absence of traffic of every type, so there is no
# packet being processed to attribute it to.  Compare with $(P)ConnSts, which
# shows whether the stream is timed out right now rather than how often it has
# been.
record(longin, "$(P)Cnt:GtmoI") {
    field(DESC, "Whole-stream receive timeouts")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) offset=5")
    field(SCAN, "1 second")
}

record(calc, "$(P)Rate:GtmoI") {
    field(DESC, "Whole-stream receive timeout rate")
    field(INPA, "$(P)Cnt:GtmoI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
    field(HIGH, "0.001")
    field(HSV , "MAJOR")
}

# Packets received, counted once per UDP datagram accepted from a configured
# peer, before any sequence reconstruction.  Each datagram counted here had a
# recognized ID field in its 8 byte ACM header, so it is attributed to that
# packet type even if the rest of the datagram turns out to be malformed and is
# later counted as an error.  Datagrams from an unconfigured address are not
# counted here at all; they are only counted as ignored.
#
# The Unknown variant counts datagrams that arrived from a configured peer but
# could not be attributed to a packet type: those shorter than the 8 byte
# header, and those whose ID field is not one of the five defined values.
record(longin, "$(P)HealthData:Cnt:RxI") {
    field(DESC, "Health data packets received")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xae offset=0")
    field(SCAN, "1 second")
}

record(calc, "$(P)HealthData:Rate:RxI") {
    field(DESC, "Health data packet receive rate")
    field(INPA, "$(P)HealthData:Cnt:RxI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "pkt/s")
    field(PREC, "0")
    field(SCAN, "1 second")
}

record(longin, "$(P)RegData:Cnt:RxI") {
    field(DESC, "Register data packets received")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0x51 offset=0")
    field(SCAN, "1 second")
}

record(calc, "$(P)RegData:Rate:RxI") {
    field(DESC, "Register data packet receive rate")
    field(INPA, "$(P)RegData:Cnt:RxI NPP MSI")
