    field(EGU , "pkt/s")
    field(PREC, "0")
    field(SCAN, "1 second")
}

# Bytes received, accumulated over the same datagrams counted by :Cnt:RxI.
# Each datagram contributes its UDP payload length (the 8 byte ACM header plus
# body) plus a fixed 42 bytes, which is the assumed size of the Ethernet, IP
# and UDP headers that carried it.  The total is therefore an estimate of
# wire bandwidth consumed by this packet type, not of payload delivered.
#
# The counter is a 32 bit signed integer and will wrap after 2 GiB; the
# :Rate:BrxI records are differential, so a single wrap distorts one sample.
record(longin, "$(P)HealthData:Cnt:BrxI") {
    field(DESC, "Health data bytes received")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xae offset=6")
    field(SCAN, "1 second")
}

record(calc, "$(P)HealthData:Rate:BrxI") {
    field(DESC, "Health data receive bit rate")
    field(INPA, "$(P)HealthData:Cnt:BrxI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C/2**20*8")
    field(EGU , "Mbps")
    field(PREC, "3")
    field(SCAN, "1 second")
}

record(longin, "$(P)RegData:Cnt:BrxI") {
    field(DESC, "Register data bytes received")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0x51 offset=6")
    field(SCAN, "1 second")
}

record(calc, "$(P)RegData:Rate:BrxI") {
    field(DESC, "Register data receive bit rate")
    field(INPA, "$(P)RegData:Cnt:BrxI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C/2**20*8")
    field(EGU , "Mbps")
    field(PREC, "3")
    field(SCAN, "1 second")
}

record(longin, "$(P)SampFault:Cnt:BrxI") {
    field(DESC, "Fault sample bytes received")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xe7 offset=6")
    field(SCAN, "1 second")
}

record(calc, "$(P)SampFault:Rate:BrxI") {
    field(DESC, "Fault sample receive bit rate")
    field(INPA, "$(P)SampFault:Cnt:BrxI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C/2**20*8")
