    field(INPA, "$(P)SampExt:Cnt:IgnI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
}

record(longin, "$(P)Unknown:Cnt:IgnI") {
    field(DESC, "Unknown type packets ignored")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0x00 offset=3")
    field(SCAN, "1 second")
}

record(calc, "$(P)Unknown:Rate:IgnI") {
    field(DESC, "Unknown type ignored packet rate")
    field(INPA, "$(P)Unknown:Cnt:IgnI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
}

# Sequences fully reassembled, counted once per sequence for which packets 0
# through the one flagged "last" were all received before the reconstruction
# timeout.  Completing a sequence is what publishes new data: it replaces the
# retained sequence for that packet type and triggers the I/O Intr scan of the
# records reading it.  So this counter is the update rate of the register and
# waveform PVs fed by this packet type.
#
# The Unknown variant can be nonzero.  Sequence reconstruction keys off the ID
# field without first checking it against the five defined values, so a packet
# carrying an unrecognized ID is still reassembled into a sequence of its own
# and counted as complete here, even though proto.md says such packets must be
# ignored.  No record reads those sequences, so the data goes nowhere; a
# nonzero count means some sender is emitting packets this IOC does not
# understand.
record(longin, "$(P)HealthData:Cnt:CplI") {
    field(DESC, "Health data sequences completed")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xae offset=4")
    field(SCAN, "1 second")
}

record(calc, "$(P)HealthData:Rate:CplI") {
    field(DESC, "Health data seq completion rate")
    field(INPA, "$(P)HealthData:Cnt:CplI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
}

record(longin, "$(P)RegData:Cnt:CplI") {
    field(DESC, "Register data sequences completed")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0x51 offset=4")
    field(SCAN, "1 second")
}

record(calc, "$(P)RegData:Rate:CplI") {
    field(DESC, "Register data seq completion rate")
    field(INPA, "$(P)RegData:Cnt:CplI NPP MSI")
