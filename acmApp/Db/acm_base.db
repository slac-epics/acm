# Malformed data and internal errors.  Counted for a datagram that was
# truncated because it exceeded the receive buffer, for one too short to hold
# the 8 byte ACM header, and for a failure of the sequence reconstruction logic
# itself (a completed sequence whose packet numbers are not contiguous, which
# should not be reachable).
#
# The Unknown variant additionally counts errors that happened outside the
# processing of any one packet: a socket level recvmsg() failure, where no
# datagram was received, and any unexpected exception escaping the receive
# loop.  Both of these throttle the receive thread for 5 seconds to limit log
# spam, so a sustained Unknown error rate also means data is being missed.
record(longin, "$(P)HealthData:Cnt:ErrI") {
    field(DESC, "Health data protocol errors")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xae offset=2")
    field(SCAN, "1 second")
}

record(calc, "$(P)HealthData:Rate:ErrI") {
    field(DESC, "Health data error rate")
    field(INPA, "$(P)HealthData:Cnt:ErrI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
    field(HIGH, "0.001")
    field(HSV , "MAJOR")
}

record(longin, "$(P)RegData:Cnt:ErrI") {
    field(DESC, "Register data protocol errors")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0x51 offset=2")
    field(SCAN, "1 second")
}

record(calc, "$(P)RegData:Rate:ErrI") {
    field(DESC, "Register data error rate")
    field(INPA, "$(P)RegData:Cnt:ErrI NPP MSI")
