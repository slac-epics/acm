# Incomplete sequences discarded, counted once per sequence that was still
# missing packets when it aged out.  A sequence is the set of packets sharing an
# ID and Timebase value, running from sequence number 0 to the packet with the
# "last" flag set.  A partial sequence is discarded once acmReconstructTimeoutMS
# has elapsed since its first packet arrived, and is counted here.
#
# This is the main indicator of packet loss for a packet type: a nonzero rate
# means data is being dropped somewhere between the ACM and this IOC.  A
# sequence that completed normally is never counted here, so this counter and
# :Cnt:CplI together account for every sequence that was started.
record(longin, "$(P)HealthData:Cnt:TmoI") {
    field(DESC, "Health data seq reassembly timeouts")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xae offset=1")
    field(SCAN, "1 second")
}

record(calc, "$(P)HealthData:Rate:TmoI") {
    field(DESC, "Health data seq timeout rate")
    field(INPA, "$(P)HealthData:Cnt:TmoI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
    field(HIGH, "0.001")
    field(HSV , "MAJOR")
}

record(longin, "$(P)RegData:Cnt:TmoI") {
    field(DESC, "Register data seq reassembly timeouts")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0x51 offset=1")
    field(SCAN, "1 second")
}

record(calc, "$(P)RegData:Rate:TmoI") {
    field(DESC, "Register data seq timeout rate")
    field(INPA, "$(P)RegData:Cnt:TmoI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
    field(HIGH, "0.001")
    field(HSV , "MAJOR")
}

record(longin, "$(P)SampFault:Cnt:TmoI") {
