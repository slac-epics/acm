    field(SCAN, "1 second")
    field(HIGH, "0.001")
    field(HSV , "MAJOR")
}

# Well formed packets deliberately discarded, counted once per datagram.  A
# packet is ignored when it belongs to a sequence that has already been
# completed or timed out (a late duplicate or retransmission), when its
# sequence number duplicates one already held in the partial sequence being
# assembled, and when its sequence number is beyond the packet that carried the
# "last" flag.
#
# Also counted, against the Unknown variant, is any datagram received from a
# source address or port that is not one of the configured peers.  Those are
# rejected before the ID field is examined, so they are not attributed to a
# packet type and are not included in :Cnt:RxI.
#
# A steady nonzero rate here is normal for a link that retransmits, but a
# growing rate alongside :Cnt:TmoI suggests sequences are arriving reordered
# badly enough that reassembly is giving up before the stragglers land.
#
# HealthData is exempt from the completed-sequence check above.  The device
# sends it as a single packet with a fixed header (seqNum and timebase both
# always 0), so consecutive updates are indistinguishable by timebase and the
# completed sequence is dropped immediately rather than retained.  Health
# updates therefore never count as duplicates of each other, and this counter
# should stay at zero for HealthData.
record(longin, "$(P)HealthData:Cnt:IgnI") {
    field(DESC, "Health data packets ignored")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xae offset=3")
    field(SCAN, "1 second")
}

record(calc, "$(P)HealthData:Rate:IgnI") {
    field(DESC, "Health data ignored packet rate")
    field(INPA, "$(P)HealthData:Cnt:IgnI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
}

record(longin, "$(P)RegData:Cnt:IgnI") {
    field(DESC, "Register data packets ignored")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0x51 offset=3")
    field(SCAN, "1 second")
}

record(calc, "$(P)RegData:Rate:IgnI") {
    field(DESC, "Register data ignored packet rate")
    field(INPA, "$(P)RegData:Cnt:IgnI NPP MSI")
    field(CALC, "C:=A-B;B:=A;C")
    field(EGU , "Hz")
    field(PREC, "0")
    field(SCAN, "1 second")
}

record(longin, "$(P)SampFault:Cnt:IgnI") {
    field(DESC, "Fault sample packets ignored")
    field(DTYP, "ACM Counter")
    field(INP , "@$(DEV) cmd=0xe7 offset=3")
    field(SCAN, "1 second")
